#!/usr/bin/env bash
set -euo pipefail

case "$*" in
  *"git/refs/tags"*"--paginate"*)
    tr ' ' '\n' <<<"${TAGS}" | sed '/^$/d'
    ;;
  *"/commits/"*)
    echo "${COMMIT_SHA}"
    ;;
  *"git/ref/tags/"*)
    args="$*"
    alias_ref=${args##*git/ref/tags/}
    grep -qx "${alias_ref}" <<<"${EXISTING_ALIASES// /$'\n'}"
    ;;
  *-X\ PATCH*)
    echo "PATCH $*" >> "${WRITES}"
    ;;
  *-X\ POST*)
    echo "POST $*" >> "${WRITES}"
    ;;
  *)
    echo "unexpected gh invocation: $*" >&2
    exit 99
    ;;
esac
